    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"You are a B2B sales analyst. Reply with JSON only: {score: 0-100, category: 'hot'|'warm'|'cold', reason: string, follow_up_email: string}. Score on company fit, budget clarity, urgency and intent in the message.\" },\n    { \"role\": \"user\", \"content\": \"Name: {{ $json.name }}\\nEmail: {{ $json.email }}\\nCompany: {{ $json.company }}\\nBudget: {{ $json.budget }}\\nMessage: {{ $json.message }}\" }\n  ]\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "0d40bc6b-d35a-418e-a8c2-0274e20a9665",
      "name": "AI Score & Qualify (OpenAI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.choices[0].message.content;\nconst ai = JSON.parse(raw);\nconst lead = $('Normalise Lead').first().json;\nreturn [{ json: { ...lead, score: ai.score, category: ai.category, reason: ai.reason, follow_up_email: ai.follow_up_email, received_at: new Date().toISOString() } }];"
      },
      "id": "2e2d3952-00d0-4dd6-9580-0aac145a2e5d",
      "name": "Parse AI Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "7165420c-7b81-44a9-af1d-1d78b7046e4d",
              "leftValue": "={{ $json.score }}",
              "rightValue": 70,
              "operator": {
                "type": "number",
                "operation": "largerEqual"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a83dbcc1-19a2-4e97-b261-08665882a7b4",
